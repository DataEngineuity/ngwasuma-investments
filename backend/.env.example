# ─────────────────────────────────────────────────────────────────────
# Ngwasuma backend — environment variables
# Copy this file to `.env` (which is gitignored) and fill in real values.
# ─────────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-secret

# Set to False in production. Never commit DEBUG=True to a public host.
DEBUG=True

# Comma-separated list of hostnames Django will serve.
# In dev: localhost,127.0.0.1
# In prod: api.ngwasumainvestments.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ── Database ─────────────────────────────────────────────────────────
# Default is SQLite (a single file in the project root). For production,
# set this to a Postgres URL, e.g.:
#   postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3


# ── CORS ─────────────────────────────────────────────────────────────
# Origins permitted to call the API from a browser. Add the frontend dev
# server here while you're developing locally, and the production frontend
# domain once you've deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── Email ────────────────────────────────────────────────────────────
# In dev, emails print to the console instead of being sent. Flip this
# to "smtp" once you've configured the SMTP host below.
EMAIL_BACKEND=console

# The "From" address used for outgoing emails.
DEFAULT_FROM_EMAIL=Ngwasuma Investments <no-reply@ngwasumainvestments.com>

# Where to send notifications when a contact or quote form is submitted.
# Usually your own info@ inbox.
LEAD_NOTIFICATION_EMAIL=info@ngwasumainvestments.com

# SMTP settings — required only when EMAIL_BACKEND=smtp.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
